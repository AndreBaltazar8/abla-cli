import "../src/cli.ab"

fun contains(value: string, expected: string): bool {
    var found = false
    var index = 0
    while (!found && index + expected.size <= value.size) {
        found = value.slice(index, index + expected.size) == expected
        index = index + 1
    }
    found
}

fun main: int {
    val app = $cli {"demo", "1.2.3", "A useful demo", [cliFlag("json", "--json", "-j", "JSON output", true)], [
        cliCommand("serve", "Serve files", ["s"], [cliOption("port", "--port", "-p", "PORT", "Listening port", false, false, "8080")], [cliArgument("directory", "Root directory")]),
        cliCommand("restore", "Restore a revision", [], [cliOption("revision", "--version", "", "VERSION", "Revision version", true)], [cliArgument("id", "Revision identifier")])
    ]}
    val parsed = app.parse(["s", "--port=9000", "public", "--json"])
    val restoreHelp = app.help(["restore"])
    if (!parsed.succeeded || !parsed.isCommand("serve")) 1
    else if (parsed.value("port") != "9000" || !parsed.has("json")) 2
    else if (parsed.argument(0) != "public") 3
    else if (!app.parse(["serve", "public"]).succeeded) 4
    else if (app.parse(["serve"]).succeeded) 5
    else if (app.parse(["serve", "public", "extra"]).succeeded) 6
    else if (app.parse(["serve", "--unknown", "public"]).succeeded) 7
    else if (app.parse(["--version"]).message != "demo 1.2.3") 8
    else if (app.help([]).size < 80) 9
    else if (!app.parse(["serve", "--help"]).succeeded) 10
    else if (!app.parse(["restore", "record", "--version", "7"]).succeeded) 11
    else if (app.parse(["restore", "record", "--version", "7"]).kind != "command") 12
    else if (app.parse(["restore", "record", "--version", "7"]).value("revision") != "7") 13
    else if (!contains(restoreHelp, "\n  -V\tShow version")) 14
    else if (contains(restoreHelp, "-V, --version")) 15
    else 0
}
